{
  "expo": {
    "name": "Tax Receipts: Scan PDF & Vault",
    "slug": "tax-receipts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "cleanreceipts",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    },
    "ios": {
      "bundleIdentifier": "com.cleanreceipts.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Tax Receipts",
        "NSCameraUsageDescription": "Tax Receipts uses the camera to scan receipts. Images stay on this device.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cleanreceipts.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Tax Receipts uses the camera to scan receipts. Images stay on this device."
        }
      ],
      "expo-localization",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "d5495531-b471-466c-835f-640dc5382a4a"
      }
    }
  }
}
